#!/usr/bin/env bash
# Anti-drift pre-commit gate.
#
# Enforces CLAUDE.md > Schema & module rules:
#   "schema.sql + seed.py + tests/ update in the SAME commit. No drift."
#
# A staged users/<name>/schema.sql must be accompanied, IN THE SAME COMMIT, by
# a staged change to that SAME user's seed.py or something under that user's
# tests/. Per-user matching is strict: users/alice/schema.sql is NOT satisfied
# by users/bob/tests/.
#
# Wired via:  git config core.hooksPath .githooks
#
# The decision logic lives in check_schema_drift() so it can be sourced and
# unit-tested against synthetic file lists with no real commits:
#   SCHEMA_GATE_SOURCE_ONLY=1 . .githooks/pre-commit
#   check_schema_drift users/alice/schema.sql
set -uo pipefail

# check_schema_drift <staged paths...>
#   exit 0 = allow commit, exit 1 = block (message on stderr)
check_schema_drift() {
  [ $# -eq 0 ] && return 0

  local f g user satisfied label seed tests_prefix
  local blocked=""

  for f in "$@"; do
    # Pattern table. Each staged schema names the exact generator and the
    # tests/ prefix that satisfy it. Matching is per-scope and strict:
    # users/alice is never satisfied by users/bob, and neither is satisfied
    # by platform.
    case "$f" in
      users/*/schema.sql)
        user=${f#users/}
        user=${user%%/*}
        # Reconstructing the path keeps deeper paths from matching loosely.
        [ "users/$user/schema.sql" = "$f" ] || continue
        label="users/$user"
        seed="users/$user/seed.py"
        tests_prefix="users/$user/tests/"
        ;;
      platform/schema.sql)
        label="platform"
        seed="platform/seed.ts"
        tests_prefix="tests/"
        ;;
      *)
        continue
        ;;
    esac

    satisfied=0
    for g in "$@"; do
      if [ "$g" = "$seed" ]; then
        satisfied=1
        break
      fi
      case "$g" in
        "$tests_prefix"*)
          satisfied=1
          break
          ;;
      esac
    done

    if [ $satisfied -eq 0 ]; then
      case " $blocked " in
        *" $label "*) ;;
        *) blocked="$blocked $label" ;;
      esac
    fi
  done

  [ -z "$blocked" ] && return 0

  {
    echo
    echo "COMMIT BLOCKED — schema drift"
    echo
    echo "CLAUDE.md > Schema & module rules:"
    echo "  \"schema.sql + seed.py + tests/ update in the SAME commit. No drift.\""
    echo
    for label in $blocked; do
      echo "  $label/schema.sql is staged, but nothing else for '$label' is."
      echo "    Stage one of these in the same commit:"
      case "$label" in
        platform)
          echo "      platform/seed.ts"
          echo "      tests/..."
          ;;
        *)
          echo "      $label/seed.py"
          echo "      $label/tests/..."
          ;;
      esac
      echo
    done
    echo "A change to another scope does not satisfy this — the match is per-scope."
    echo
    echo "Stage the companion change (seed.py/seed.ts or a tests/ file) in"
    echo "this same commit — that is the fix Gate A is asking for."
    echo
  } >&2

  return 1
}

# ---------------------------------------------------------------------------
# Gate B — test coverage.
#
# CLAUDE.md > Testing: "Changes to data logic (queries, panels, derived
# tables) require test changes in the same commit. Pure styling/copy changes
# do not."
#
# Each staged path classifies as exempt, a test, or guarded. A guarded scope
# with no staged test IN ITS OWN SCOPE blocks the commit.
# ---------------------------------------------------------------------------

# _gate_b_class <path>
#   prints: exempt | test:<scope> | guard:<scope> | unguarded
_gate_b_class() {
  local p=$1 u

  # Runtime prose, not documentation and not logic. platform/prompts/*.md is
  # loaded at request time and its sha is stamped on every transcript row.
  # The loader and the hash stamping ARE tested (tests/chat/prompt.test.ts);
  # the prose is not, because a test over wording would pin style rather than
  # behaviour. Listed explicitly rather than relying on the *.md arm below,
  # which exempts it only by accident of file extension. Scoped to *.md
  # specifically because `case` globbing lets `*` match `/`: a bare
  # platform/prompts/* would exempt a future loader or fixture placed in that
  # directory, and only the prose is meant to be exempt.
  case "$p" in
    platform/prompts/*.md) echo "exempt"; return ;;
  esac

  # Docs first: a .md is never a test, even under tests/.
  case "$p" in
    *.md|docs/*|LICENSE) echo "exempt"; return ;;
  esac

  # Test paths, which satisfy their own scope.
  case "$p" in
    tests/*) echo "test:platform"; return ;;
    modules/tests/*) echo "test:modules"; return ;;
    .claude/hooks/test-hooks.sh) echo "test:guards"; return ;;
    users/*/tests/*)
      u=${p#users/}
      u=${u%%/*}
      echo "test:user:$u"
      return
      ;;
  esac

  # Gate A's territory. Exempt here so the two gates do not overlap: without
  # this, Gate B would force tests/ for platform/schema.sql and kill Gate A's
  # seed branch, and would break the existing "schema + same-user seed.py"
  # verdict.
  case "$p" in
    schema.sql|*/schema.sql|platform/seed.ts|users/*/seed.py) echo "exempt"; return ;;
  esac

  # Styling, assets, and named config.
  case "$p" in
    *.css|*.scss|*.svg|public/*|mockup.html|*/mockup.html) echo "exempt"; return ;;
    next.config.*|vitest.config.*|tsconfig*|Caddyfile|.gitignore|setup.sh|deploy/*) echo "exempt"; return ;;
  esac

  # Extension-based config exemption, ROOT LEVEL ONLY.
  #
  # `case` globs match `/`, so a bare `*.json` arm would also exempt
  # lib/config.json, platform/rules.yaml, and users/alice/app/data.json —
  # failing Gate B open for fixtures and rule tables living inside guarded
  # scopes. Only a path with no slash is tooling config.
  case "$p" in
    */*) ;;
    *.json|*.yml|*.yaml|*.toml) echo "exempt"; return ;;
  esac

  # Guarded scopes.
  case "$p" in
    app/*|lib/*|platform/*|middleware.ts|scripts/*) echo "guard:platform"; return ;;
    modules/*) echo "guard:modules"; return ;;
    .githooks/*|.claude/hooks/*) echo "guard:guards"; return ;;
    users/*/*)
      u=${p#users/}
      u=${u%%/*}
      echo "guard:user:$u"
      return
      ;;
    # A shared file directly under users/ — e.g. a registry or an index. It
    # is platform code, so its test belongs under tests/, and without this arm
    # it falls through every case below and classifies as `unguarded`.
    #
    # MUST stay AFTER users/*/* : `case` globs match '/', so users/*.ts also
    # matches users/alice/queries.ts. Placed first it would classify every
    # per-user file as platform scope, and a users/alice change would be
    # satisfied by a test under tests/. The alice case in test-hooks.sh is
    # what catches that.
    users/*.ts|users/*.tsx|users/*.sh) echo "guard:platform"; return ;;
  esac

  # Root-level TypeScript that fell through everything above
  # (instrumentation.ts, sentry.config.ts, and future siblings). This is
  # deliberately guarded, not exempt: scripts/create-dev-users.ts shipped
  # untested specifically because the old fall-through called root-level
  # .ts "unguarded". Only a path with no slash reaches here.
  case "$p" in
    */*) ;;
    *.ts|*.tsx) echo "guard:platform"; return ;;
  esac

  echo "unguarded"
}

# check_test_coverage <staged paths...>
#   exit 0 = allow commit, exit 1 = block (message on stderr)
check_test_coverage() {
  [ $# -eq 0 ] && return 0

  local p class scope
  local guarded="" satisfied="" untested="" unsatisfied=""

  for p in "$@"; do
    class=$(_gate_b_class "$p")
    case "$class" in
      test:*)
        scope=${class#test:}
        case " $satisfied " in
          *" $scope "*) ;;
          *) satisfied="$satisfied $scope" ;;
        esac
        ;;
      guard:*)
        scope=${class#guard:}
        case " $guarded " in
          *" $scope "*) ;;
          *) guarded="$guarded $scope" ;;
        esac
        untested="${untested}${scope} ${p}
"
        ;;
    esac
  done

  for scope in $guarded; do
    case " $satisfied " in
      *" $scope "*) ;;
      *) unsatisfied="$unsatisfied $scope" ;;
    esac
  done

  [ -z "$unsatisfied" ] && return 0

  # An announced skip. Printed only when the gate WOULD have blocked, so a
  # SKIP_TEST_GATE exported in a shell profile cannot produce noise that
  # trains the eye to ignore it.
  if [ "${SKIP_TEST_GATE:-0}" = "1" ]; then
    {
      echo
      echo "Gate B SKIPPED (SKIP_TEST_GATE=1) — these guarded files ship untested:"
      for scope in $unsatisfied; do
        printf '%s' "$untested" | while IFS=' ' read -r s f; do
          [ "$s" = "$scope" ] && printf '  %-11s %s\n' "$scope:" "$f"
        done
      done
      echo
      echo "CLAUDE.md > Testing: state the reason for the skip in the commit message."
      echo
    } >&2
    return 0
  fi

  {
    echo
    echo "COMMIT BLOCKED — untested change"
    echo
    echo "CLAUDE.md > Testing:"
    echo "  \"Changes to data logic (queries, panels, derived tables) require"
    echo "   test changes in the same commit.\""
    echo
    for scope in $unsatisfied; do
      echo "  scope '$scope' has guarded changes and no staged test:"
      printf '%s' "$untested" | while IFS=' ' read -r s f; do
        [ "$s" = "$scope" ] && echo "      $f"
      done
      case "$scope" in
        platform) echo "    Satisfy it by staging a test under: tests/" ;;
        modules)  echo "    Satisfy it by staging a test under: modules/tests/" ;;
        guards)   echo "    Satisfy it by staging: .claude/hooks/test-hooks.sh" ;;
        user:*)   echo "    Satisfy it by staging a test under: users/${scope#user:}/tests/" ;;
      esac
      echo
    done
    echo "Pure styling or copy changes are exempt by path. If this change is one"
    echo "of those and the path cannot say so, re-run with:"
    echo "  SKIP_TEST_GATE=1 git commit ..."
    echo
  } >&2

  return 1
}

# ---------------------------------------------------------------------------
# Gate C — typecheck.
#
# next.config.ts sets no typescript.ignoreBuildErrors, so a TypeScript error
# is a hard `next build` failure, not a warning. vitest cannot catch this: it
# transpiles through esbuild, which strips types without ever checking them,
# so a fully green suite proves nothing about type correctness. This gate is
# the only thing in the repo that actually runs the compiler.
#
# Known limitation: `tsc --noEmit` checks the working tree, not the staged
# content, so a commit that stages only part of a file's changes gets
# typechecked against code that is not exactly what is being committed. This
# is accepted — mutating the working tree from a pre-commit hook to close
# that gap risks destroying uncommitted work, which is worse than the gap.
# ---------------------------------------------------------------------------

# check_typecheck <staged paths...>
#   exit 0 = allow commit, exit 1 = block (message on stderr)
check_typecheck() {
  [ $# -eq 0 ] && return 0

  local f has_ts=0
  for f in "$@"; do
    case "$f" in
      *.ts|*.tsx) has_ts=1; break ;;
    esac
  done
  [ $has_ts -eq 0 ] && return 0

  # Indirected so the harness can substitute a stub and run this group in
  # milliseconds instead of shelling out to tsc dozens of times.
  local TYPECHECK_CMD="${TYPECHECK_CMD:-npx tsc --noEmit}"

  local out rc
  out=$($TYPECHECK_CMD 2>&1)
  rc=$?
  [ $rc -eq 0 ] && return 0

  # Exit 127 means the shell could not find/run TYPECHECK_CMD at all (e.g.
  # no `npx`/`tsc` on PATH) — that is a broken environment, not a type
  # error, and must not be reported to the developer as one.
  local internal_failure=0
  [ $rc -eq 127 ] && internal_failure=1

  # An announced skip. Printed only when the gate WOULD have blocked, so a
  # SKIP_TYPECHECK exported in a shell profile cannot produce noise that
  # trains the eye to ignore it.
  if [ "${SKIP_TYPECHECK:-0}" = "1" ]; then
    {
      echo
      if [ $internal_failure -eq 1 ]; then
        echo "Gate C SKIPPED (SKIP_TYPECHECK=1) — could not run the typechecker:"
      else
        echo "Gate C SKIPPED (SKIP_TYPECHECK=1) — TypeScript errors are being ignored:"
      fi
      echo
      echo "$out"
      echo
      echo "CLAUDE.md > Testing: state the reason for the skip in the commit message."
      echo
    } >&2
    return 0
  fi

  {
    echo
    if [ $internal_failure -eq 1 ]; then
      echo "COMMIT BLOCKED — Gate C could not run the typechecker"
      echo
      echo "TYPECHECK_CMD exited 127 (command not found). This is an environment"
      echo "problem — e.g. no npx/tsc on PATH — not a type error."
    else
      echo "COMMIT BLOCKED — TypeScript errors"
      echo
      echo "next.config.ts sets no typescript.ignoreBuildErrors, so this is a hard"
      echo "'next build' failure, not a warning. vitest cannot catch it: it"
      echo "transpiles through esbuild, which strips types without checking them."
    fi
    echo
    echo "$out"
    echo
    echo "SKIP_TYPECHECK=1 git commit ... bypasses this gate for genuine"
    echo "exceptions, but that should be rare. Prefer fixing the underlying"
    echo "problem instead."
    echo
  } >&2

  return 1
}

# When sourced by the test harness, stop here and expose the function only.
if [ "${SCHEMA_GATE_SOURCE_ONLY:-0}" = "1" ]; then
  return 0 2>/dev/null || exit 0
fi

# ---------------------------------------------------------------------------
# Main: collect staged paths and apply the gate.
# ---------------------------------------------------------------------------

files=()
while IFS= read -r line; do
  [ -n "$line" ] && files+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR)

# All three gates run; all failures are reported before exiting, so a commit
# that trips more than one does not require multiple round trips to discover
# that.
rc=0
check_schema_drift ${files[@]+"${files[@]}"} || rc=1
check_test_coverage ${files[@]+"${files[@]}"} || rc=1
check_typecheck ${files[@]+"${files[@]}"} || rc=1
[ $rc -ne 0 ] && exit 1

exit 0
