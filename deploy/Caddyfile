app.stairwell.run {
	encode zstd gzip

	# ACCESS LOGGING, ADDED FOR A DIAGNOSIS THAT STALLED WITHOUT IT.
	#
	# Caddy logs errors even with no access log configured, which is how the
	# proposal teardowns were found at all ("aborting with incomplete response",
	# "reading: context canceled"). What it does NOT give is the other side of
	# the picture: when a request STARTED, how many there were, and which ones
	# completed. Without that, the only visible requests are the ones that
	# failed, and unified-loop ledger D13 spent an hour on a phantom-extra-POST
	# theory that a single line of access log would have settled.
	#
	# Keep this on until the authoring teardowns are understood. It is not
	# permanent furniture — revisit once D13 closes.
	#
	# To a FILE rather than the journal, for two reasons: `journalctl -u caddy`
	# is where the abort warnings are read from, and burying those under every
	# asset request makes the thing we actually watch harder to see; and the
	# droplet has 1GB of disk headroom, so the roll limits below are what stop a
	# log from becoming an outage.
	#
	# On content: Caddy redacts the Cookie header by default, so no session
	# token is written here, and it never logs request bodies — no chat message,
	# no spec, no transcript content. URIs do carry the friend's slug (/run5),
	# which is the same identifier `metrics` already stores on invite rows.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}

	reverse_proxy 127.0.0.1:3000
}
