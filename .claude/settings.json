{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-sensitive-files.sh\"",
            "timeout": 10,
            "statusMessage": "Checking data-safety rules..."
          }
        ]
      }
    ]
  }
}
